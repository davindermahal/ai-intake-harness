# Secrets / local env
.env
.env.local
.env.*.local

# Runtime state (see README.md "Runtime state (gitignored)")
.intake/

# Self-hosting (dogfooding): this repo uses its own Jira ticketing to drive its own development
# (see README.md "Quickstart" step 2 / .ai/plans/completed/jira-tags-tracker-adapter.md). These
# wire the harness to Jira, and provision worktrees, for THAT purpose only — never committed, so
# they can never ship to a consumer that vendors this repo via git subtree.
/.ai/intake.config
/.ai/prompts/
/scripts/
/.claude/settings.ai-harness-dev.json
# NOTE: /Makefile is deliberately NOT listed here (unlike the dogfooding files above) — it now
# holds this repo's own lint/test/test-live targets (see .ai/plans/active/2026-08-21-test-suite-
# plan.md), committed so CI can run `make test`/`make lint` against a fresh checkout. It carries no
# self-hosted worktree-go/worktree-new/etc targets (those stay consumer-owned, per README.md's
# "Wire up the Makefile"), so vendoring it via git subtree into a consumer's ai-intake-harness/
# subdirectory is harmless — it never collides with the consumer's own root Makefile.

# Python (lib/tracker/jira_cookie_extract.py)
__pycache__/
*.pyc

# JetBrains
.idea/

# VS Code
.vscode/*
!.vscode/extensions.json

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo

# Emacs
*~
\#*\#
.\#*

# Claude Code local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
