# Copy to .env.local (gitignored — never commit it with real values) and fill in your Jira
# credentials. These are the only vars lib/tracker/jira-common.sh's jira_common_load_env loads from
# .env / .env.local; everything else (TRACKER, TRACKER_PROJECT_KEY, TRACKER_APP_TAG, ...) is
# non-secret config and belongs in .ai/intake.config instead — see README.md "Quickstart".
#
# `install.sh` copies this file to .env.local for you and runs a connectivity check once it's
# filled in.

JIRA_SITE_URL=https://your-site.atlassian.net

# Have an Atlassian API token? Fill these in
# (https://id.atlassian.com/manage-profile/security/api-tokens):
JIRA_INTAKE_EMAIL=you@your-domain.com
JIRA_INTAKE_API_TOKEN=your-api-token-here

# No API token available (e.g. blocked by org policy)? Delete/blank out the two lines above
# instead — the harness then falls back to a browser session cookie:
#   - Requires python3 + `pip install browser_cookie3` on THIS machine (the one running cron) —
#     nothing else in the harness needs Python; if you're using the API token above, skip this
#     entirely, no Python required.
#   - Extracts a fresh cookie straight from your browser's cookie store on every run (poll cycle,
#     tracker-comment.sh, tracker-transition.sh) — never written to disk, never cached. Stay logged
#     into Jira in Chrome or Firefox on this machine and it keeps working with no further action.
#   - Tries every browser it can find and uses whichever has a working Jira session; to pin one
#     specific browser instead (e.g. if a stale cookie sits in another one), set
#     JIRA_COOKIE_BROWSER=chrome (or firefox, edge, brave, ...) in .ai/intake.config — it's not a
#     secret, so it doesn't belong in this file. install.sh doesn't read .ai/intake.config though,
#     so pass it as a one-off env var prefix instead when testing (see below).
#   - Needs a normal, unlocked desktop login session (it reads the OS keyring — GNOME
#     Keyring/KWallet — to decrypt Chrome's cookie store) — this mode does not work on a headless
#     server with no browser/desktop session on it.
#   - Test this path specifically, independent of whatever's above, with:
#       ai-intake-harness/install.sh --test-cookie
#     or, to also pin a browser for that one check:
#       JIRA_COOKIE_BROWSER=firefox ai-intake-harness/install.sh --test-cookie
#     See README.md "Set up Jira credentials" and .ai/plans/active/jira-cookie-auth-fallback.md for
#     the full design and trade-offs.
